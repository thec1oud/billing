# Local development defaults. These credentials are for local containers only.
APP_ENV=development
APP_PORT=8080
APP_HOST_PORT=8080
BFF_HOST_PORT=3000
WEB_HOST_PORT=8081
MOCK_IDENTITY_HOST_PORT=8090
ENABLE_DEV_ENDPOINTS=true
SEED_DB=false

# Local mock OIDC issuer. Use a real HTTPS issuer for production.
AUTH_JWKS_URL=http://mock-identity:8090/.well-known/jwks.json
AUTH_ISSUER=http://mock-identity:8090
AUTH_AUDIENCE=billing-api
FAKE_WEBHOOK_HMAC_SECRET=local-development-only-webhook-secret-12345

DB_HOST=app-db
DB_PORT=5432
DB_HOST_PORT=5432
DB_USER=billing
DB_PASSWORD=billing_local_dev
DB_NAME=billing

REDIS_HOST=app-redis
REDIS_PORT=6379
REDIS_HOST_PORT=6379
REDIS_PASSWORD=redis_local_dev

RABBITMQ_HOST=app-rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672
RABBITMQ_DEFAULT_USER=billing
RABBITMQ_DEFAULT_PASS=rabbit_local_dev

LOG_TARGETS=CONSOLE
