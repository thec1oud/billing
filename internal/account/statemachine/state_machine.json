      "EmitEventType": "billing.account.activated",
      "Actions": [
        {
          "Seq": 1,
          "ActionName": "account.action.activate",
          "ParamsKind": "STATIC",
          "Mode": "SYNC",
          "OnError": "ABORT"
        }
      ]
    },
    {
      "FromState": "SUSPENDED",
      "EventName": "reactivate",
      "ToState": "ACTIVE",
      "EmitEventType": "billing.account.activated",
