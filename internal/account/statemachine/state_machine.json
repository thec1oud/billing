          "Mode": "SYNC",
          "OnError": "ABORT"
        }
      ]
    },
    {
      "FromState": "ACTIVE",
      "EventName": "suspend",
      "ToState": "SUSPENDED",
      "EmitEventType": "billing.account.suspended",
      "Actions": [
        {
          "Seq": 1,
          "ActionName": "account.action.suspend",
          "ParamsKind": "STATIC",
          "Mode": "SYNC",
          "OnError": "ABORT"
        }
      ]
    },
    {
      "FromState": "ACTIVE",
      "EventName": "close",
      "ToState": "CLOSED",
      "EmitEventType": "billing.account.closed",
      "Actions": [
        {
          "Seq": 1,
          "ActionName": "account.action.close",
          "ParamsKind": "STATIC",
          "Mode": "SYNC",
          "OnError": "ABORT"
        }
      ]
    },
    {
      "FromState": "SUSPENDED",
      "EventName": "close",
      "ToState": "CLOSED",
      "EmitEventType": "billing.account.closed",
      "Actions": [
        {
          "Seq": 1,
          "ActionName": "account.action.close",
          "ParamsKind": "STATIC",
          "Mode": "SYNC",
          "OnError": "ABORT"
        }
      ]
    }
  ]
