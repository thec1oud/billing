{
  "MachineType": "invoice_lifecycle",
  "Version": 2,
  "InitialState": "DRAFT",
  "Activate": true,
  "States": [
    { "Name": "DRAFT" },
    { "Name": "OPEN" },
    { "Name": "PAID", "IsFinal": true },
    { "Name": "UNCOLLECTIBLE", "IsFinal": true },
    { "Name": "VOID", "IsFinal": true }
  ],
  "Transitions": [
    {
      "FromState": "DRAFT",
      "EventName": "finalize",
      "ToState": "OPEN",
      "EmitEventType": "billing.invoice.finalized",
      "Actions": [
        {
          "Seq": 1,
          "ActionName": "invoice.action.finalize",
          "ParamsKind": "STATIC",
          "Mode": "SYNC",
          "OnError": "ABORT"
        }
      ]
    },
    {
      "FromState": "OPEN",
      "EventName": "pay",
      "ToState": "PAID",
      "EmitEventType": "billing.invoice.paid",
      "Actions": [
        {
          "Seq": 1,
          "ActionName": "invoice.action.mark_paid",
          "ParamsKind": "STATIC",
          "Mode": "SYNC",
          "OnError": "ABORT"
        }
      ]
    },
    {
      "FromState": "OPEN",
      "EventName": "void",
      "ToState": "VOID",
      "EmitEventType": "billing.invoice.voided",
      "Actions": [
        {
          "Seq": 1,
          "ActionName": "invoice.action.void",
          "ParamsKind": "STATIC",
          "Mode": "SYNC",
          "OnError": "ABORT"
        }
      ]
    }
  ]
}
